100 REM SPEECH SYNTHESIZER DEMO
110 REM TI EXTENDED BASIC ONLY. NEEDS
120 REM SPCHROM.BIN IN /BIOS ON THE SD
130 DIM U$(9),E$(9),T$(9)
140 HX$="0123456789ABCDEF" :: RESTORE 3000
150 FOR I=1 TO 9 :: READ U$(I) :: NEXT I
160 FOR I=0 TO 9 :: READ E$(I) :: NEXT I
170 FOR I=2 TO 9 :: READ T$(I) :: NEXT I
180 CALL SPGET("HIGHER",HI$) :: CALL SPGET("LOWER",LO$)
190 CALL SAY("HELLO I AM A #TEXAS INSTRUMENTS# COMPUTER")
200 REM MENU
210 CALL CLEAR :: CALL SCREEN(8) :: PRINT "SPEECH DEMO" :: PRINT
220 PRINT "1 WORDS AND SENTENCES" :: PRINT "2 PHRASES"
230 PRINT "3 SPELLING" :: PRINT "4 NUMBERS" :: PRINT "5 COLORS"
240 PRINT "6 SPGET" :: PRINT "7 GUESSING GAME"
250 PRINT "8 TYPE YOUR OWN" :: PRINT "0 QUIT" :: PRINT
260 CALL KEY(0,K,S) :: IF S<1 OR K<48 OR K>56 THEN 260
270 IF K=48 THEN 1100
280 CALL CLEAR :: ON K-48 GOSUB 300,400,500,600,700,800,900,1000
290 PRINT :: PRINT "PRESS ANY KEY" :: GOSUB 1900 :: GOTO 210
300 REM 1: WORDS AND SENTENCES
310 PRINT "WORDS FROM THE BUILT-IN" :: PRINT "VOCABULARY:" :: PRINT
320 S$="HELLO" :: GOSUB 1800
330 S$="I CAN SAY MORE THAN THREE HUNDRED WORDS" :: GOSUB 1800
340 S$="THE ANSWER IS FORTY TWO" :: GOSUB 1800
350 S$="DO YOU WANT TO PLAY" :: GOSUB 1800
360 RETURN
400 REM 2: PHRASES
410 PRINT "MULTI-WORD ENTRIES NEED" :: PRINT "# SIGNS AROUND THEM." :: PRINT
420 S$="#TEXAS INSTRUMENTS#" :: GOSUB 1800
430 S$="#READY TO START#" :: GOSUB 1800
440 S$="#THAT IS RIGHT#" :: GOSUB 1800
450 S$="#WHAT WAS THAT#" :: GOSUB 1800
460 PRINT :: PRINT "WITHOUT # SIGNS EACH WORD" :: PRINT "IS LOOKED UP ON ITS OWN:"
470 S$="TEXAS INSTRUMENTS" :: GOSUB 1800
480 RETURN
500 REM 3: SPELLING
510 PRINT "WORDS THAT ARE NOT IN THE" :: PRINT "VOCABULARY ARE SPELLED." :: PRINT
520 S$="PICO" :: GOSUB 1800
530 S$="TI 99 4A" :: GOSUB 1800
540 S$="HELLO PICO" :: GOSUB 1800
550 RETURN
600 REM 4: NUMBERS IN WORDS
610 PRINT "NUMBERS MADE FROM WORDS" :: PRINT
620 FOR N=1 TO 10 :: GOSUB 2000 :: PRINT N;W$ :: CALL SAY(W$) :: NEXT N
630 PRINT :: RANDOMIZE
640 FOR I=1 TO 4 :: N=INT(RND*1000) :: GOSUB 2000
650 PRINT N;W$ :: CALL SAY(W$) :: NEXT I
660 N=16 :: GOSUB 2000 :: PRINT N;W$ :: CALL SAY(W$)
670 RETURN
700 REM 5: COLORS
710 PRINT "COLOR NAMES" :: PRINT
720 RESTORE 3040 :: FOR I=1 TO 9 :: READ C$,C
730 PRINT C$ :: CALL SAY(C$) :: CALL SCREEN(C) :: NEXT I
740 RETURN
800 REM 6: SPGET
810 PRINT "CALL SPGET COPIES A WORD'S" :: PRINT "SPEECH DATA INTO A STRING."
820 CALL SPGET("HELLO",A$) :: CALL SPGET("THERE",B$)
830 IF LEN(A$)=0 THEN PRINT "NO SPEECH DATA" :: RETURN
840 PRINT :: PRINT "HELLO IS";LEN(A$);"BYTES:"
850 FOR I=1 TO 8 :: X=ASC(SEG$(A$,I,1)) :: GOSUB 2200 :: NEXT I :: PRINT
860 PRINT :: PRINT "CALL SAY(,A$)" :: CALL SAY(,A$)
870 PRINT "CALL SAY(,A$,,B$)" :: CALL SAY(,A$,,B$)
880 PRINT "CALL SAY(,A$,,A$,,A$)" :: CALL SAY(,A$,,A$,,A$)
890 RETURN
900 REM 7: GUESSING GAME
910 PRINT "GUESS MY NUMBER, 1 TO 100." :: PRINT
915 PRINT "HIGHER AND LOWER WERE" :: PRINT "FETCHED WITH SPGET." :: PRINT
920 RANDOMIZE :: SN=INT(RND*100)+1 :: G=0
930 CALL SAY("GUESS A NUMBER BETWEEN ONE AND ONE HUNDRED")
940 INPUT "GUESS? ":X :: G=G+1 :: IF X=SN THEN 970
950 IF X<SN THEN PRINT "HIGHER" :: CALL SAY(,HI$) ELSE PRINT "LOWER" :: CALL SAY(,LO$)
960 GOTO 940
970 N=G :: GOSUB 2000 :: PRINT "RIGHT! YOU GOT IT IN";G
980 CALL SAY("#THAT IS RIGHT# YOU GOT IT IN "&W$)
990 RETURN
1000 REM 8: TYPE YOUR OWN
1010 PRINT "TYPE WORDS TO HEAR THEM." :: PRINT "USE # SIGNS FOR PHRASES."
1020 PRINT "AN EMPTY LINE RETURNS." :: PRINT
1030 LINPUT "> ":W$ :: IF W$="" THEN RETURN
1040 CALL SAY(W$) :: GOTO 1030
1100 CALL CLEAR :: PRINT "GOODBYE" :: CALL SAY("GOODBYE") :: END
1800 REM PRINT AND SAY S$
1810 PRINT S$ :: CALL SAY(S$) :: RETURN
1900 REM WAIT FOR A NEW KEY
1910 CALL KEY(0,K,S) :: IF S<1 THEN 1910
1920 RETURN
2000 REM W$ = N (0 TO 999) IN WORDS
2010 W$="" :: H=INT(N/100) :: R=N-100*H
2020 IF N=0 THEN W$="ZERO" :: RETURN
2030 IF H>0 THEN P$=U$(H)&" HUNDRED" :: GOSUB 2100
2040 IF R>=20 THEN P$=T$(INT(R/10)) :: R=R-10*INT(R/10) :: GOSUB 2100
2050 IF R>=10 THEN P$=E$(R-10) :: R=0 :: GOSUB 2100
2060 IF R>0 THEN P$=U$(R) :: GOSUB 2100
2070 RETURN
2100 IF W$="" THEN W$=P$ ELSE W$=W$&" "&P$
2110 RETURN
2200 REM PRINT BYTE X AS HEX
2210 PRINT SEG$(HX$,INT(X/16)+1,1)&SEG$(HX$,X-16*INT(X/16)+1,1)&" ";
2220 RETURN
